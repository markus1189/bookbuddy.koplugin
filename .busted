-- busted config. Lives at the repo root (not tests/) because busted only
-- auto-discovers .busted in the working directory, and `nix run .#check`/`.#test`
-- run from here. Runs under LuaJIT (KOReader's runtime). Specs live in tests/ and
-- match *_spec.lua; modules under test are required by short name via lpath.
return {
    default = {
        lua = "luajit",
        ROOT = { "tests" },
        -- Discovery matches *_spec.lua. Files under tests/integration/ deliberately
        -- do NOT use the _spec suffix (smoke_real.lua, tools.lua): they need the real
        -- KOReader/crengine harness and are run by explicit path via `nix run
        -- .#test-real`, so this pure-luajit suite must not auto-discover them.
        pattern = "_spec",
        lpath = "./?.lua;./tests/?.lua",
    },
}
